{
  "name": "@theelephantcoder/agent-harness",
  "version": "0.1.2",
  "description": "Performance layer for coding agents. Skills, instincts, memory, security and research-first that works across Claude Code, Codex, Opencode, Cursor, Kiro CLI, Kiro, Cline, Aider.",
  "type": "module",
  "bin": {
    "harness": "./dist/harness/cli.js"
  },
  "main": "./dist/harness/index.js",
  "scripts": {
    "bench": "tsx src/harness/bench.ts",
    "build": "tsc",
    "prepare": "npm install --no-save --ignore-scripts --no-audit --no-fund --prefix \"${npm_package_json%/*}\" && npm run build",
    "doctor": "tsx src/harness/cli.ts doctor",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src"
  },
  "keywords": [
    "agent",
    "harness",
    "claude-code",
    "opencode",
    "codex",
    "cursor",
    "kiro",
    "kiro-cli",
    "cline",
    "aider",
    "skills"
  ],
  "author": "TheElephantCoder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheElephantCoder/agent-harness.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "vitest": "^1.0.0"
  },
  "files": [
    "src/",
    "skills/",
    "instincts/",
    "memory/",
    "security/",
    "research/",
    "adapters/",
    "docs/",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "dist/"
  ]
}
